{#- The frame of every HTML mail sent by MailSenderService. Mail clients read
    tables and inline styles, not stylesheets: the frame is drawn with them.
    An application gives its own layout (wexample_symfony_mail.layout), which
    may extend this one and override `header`, `body` or `footer`. -#}
<!DOCTYPE html>
<html lang="{{ mail_locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ email.subject }}</title>
</head>
<body style="margin: 0; padding: 0; background: #f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #f4f4f5;">
    <tr>
        <td align="center" style="padding: 24px 12px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background: #ffffff; border-radius: 8px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.5; color: #18181b;">
                {%- block header -%}
                    {%- if mail_app_name -%}
                        <tr>
                            <td style="padding: 20px 32px; border-bottom: 1px solid #e4e4e7; font-size: 17px; font-weight: bold;">{{ mail_app_name }}</td>
                        </tr>
                    {%- endif -%}
                {%- endblock -%}
                <tr>
                    <td style="padding: 32px;">
                        {%- block body -%}
                            {%- include mail_template -%}
                        {%- endblock -%}
                    </td>
                </tr>
                {%- block footer -%}
                    <tr>
                        <td style="padding: 20px 32px; border-top: 1px solid #e4e4e7; font-size: 12px; color: #71717a;">
                            {{- 'WexampleSymfonyMailBundle.mails.layout::footer' | trans -}}
                        </td>
                    </tr>
                {%- endblock -%}
            </table>
        </td>
    </tr>
</table>
</body>
</html>
