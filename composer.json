{
  "name": "wexample/symfony-mail",
  "description": "Mails for Symfony: a sender every mail goes through, and a development mailbox",
  "version": "3.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMail\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyMail\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/mailer": "^7.4",
    "symfony/mime": "^7.4 || ^8.0",
    "symfony/twig-bridge": "^7.4",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.3.0",
    "wexample/symfony-translations": ">=15.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}