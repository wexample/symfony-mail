{
  "name": "wexample/symfony-mail",
  "description": "Mails for Symfony: a development mailbox, and what every mail of an application needs",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMail\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyMail\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/mailer": "^7.4",
    "symfony/mime": "^7.4 || ^8.0",
    "wexample/symfony-helpers": ">=12.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "symfony/twig-bridge": "^7.4",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
